# =============================================================================
# .env de exemplo — projeto Vercel do TENANT: EXP TOUR
# Copie para o projeto EXP Tour na Vercel (Settings -> Environment Variables).
# Placeholders apenas — nunca comite segredos reais (.gitignore ignora .env).
# Ver docs/deploy-multi-tenant.md.
#
# Legenda:
#   [DIFERE]        muda entre EXP Tour e Forio
#   [COMPARTILHADO] mesmo valor nos dois projetos
#   [DECISAO]       depende de a conta do provedor ser compartilhada ou por tenant
# =============================================================================

# --- Tenant do deploy (a chave de tudo) --------------------------------------
CATALOGO_TENANT_SLUG=exp-tour        # [DIFERE]
EMAIL_DEFAULT_TENANT_SLUG=exp-tour   # [DIFERE] deixe igual ao slug acima

# --- URL publica -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://exp-tour.vercel.app   # [DIFERE] (ou dominio proprio)

# --- Banco (Supabase) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://lvchpskxeohfmistppxl.supabase.co  # [COMPARTILHADO]
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # [COMPARTILHADO]
SUPABASE_SERVICE_ROLE_KEY=           # [COMPARTILHADO]

# --- E-mails (Resend) --------------------------------------------------------
RESEND_API_KEY=                                              # [COMPARTILHADO] (ou por tenant)
RESEND_FROM_EMAIL=Área do Cliente EXP Tour <noreply@exp-tour.com>  # [DIFERE] dominio verificado no Resend
# EMAIL_LOGO_URL so se o logo estiver num CDN (senao usa o asset padrao da marca).
EMAIL_LOGO_URL=                                             # [DIFERE] opcional

# --- Marca / links exibidos --------------------------------------------------
ADMIN_EMAIL=rodrigo@exp-tour.com                           # [DIFERE] alertas internos
NEXT_PUBLIC_POLITICA_PRIVACIDADE_URL=https://www.exp-tour.com/politica-de-privacidade  # [DIFERE] confira a rota real (site WordPress)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=                             # [DIFERE]
NEXT_PUBLIC_AFILIADO_CHIP_URL=                             # [DIFERE]
NEXT_PUBLIC_AFILIADO_MOEDA_URL=                            # [DIFERE]
NEXT_PUBLIC_AFILIADO_PASSAGEM_URL=                         # [DIFERE]
NEXT_PUBLIC_AFILIADO_VISTO_URL=                            # [DIFERE]

# --- Pagamento (Mercado Pago) ------------------------------------------------
# Token de PRODUCAO comeca com "APP_USR-". O webhook secret precisa ser da MESMA
# aplicacao do access token. Webhook do MP aponta para
# ${NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago.
MERCADOPAGO_ACCESS_TOKEN=            # [DECISAO]
MERCADOPAGO_WEBHOOK_SECRET=          # [DECISAO]
MP_NOTIFICATION_URL=                 # legado: deixe em branco (deriva de APP_URL)

# --- CRM/Sign (Zoho) ---------------------------------------------------------
ZOHO_CLIENT_ID=                      # [DECISAO]
ZOHO_CLIENT_SECRET=                  # [DECISAO]
ZOHO_REFRESH_TOKEN=                  # [DECISAO]
ZOHO_WEBHOOK_SECRET=                 # [DECISAO] header x-exp-webhook-token na Workflow Rule

# --- WhatsApp ----------------------------------------------------------------
WHATSAPP_APP_SECRET=                 # [DECISAO]
WHATSAPP_ACCESS_TOKEN=               # [DECISAO]
WHATSAPP_PHONE_NUMBER_ID=            # [DECISAO]
WHATSAPP_VERIFY_TOKEN=               # [DECISAO]

# --- Cron --------------------------------------------------------------------
# ATENCAO (ver runbook, secao Cron): a maioria dos crons ainda e global. Por ora,
# mantenha o Vercel Cron ATIVO so no projeto EXP Tour; desative os jobs no Forio.
CRON_SECRET=                         # recomendado distinto por projeto

# --- Segredos de sessao (recomendado DISTINTOS por projeto) ------------------
SESSION_SECRET=                      # [DIFERE recomendado]
ADMIN_SESSION_SECRET=                # [DIFERE recomendado]
SUPPLIER_SESSION_SECRET=             # [DIFERE recomendado] (fallback: SESSION_SECRET)
ADMIN_CAMBIO_SECRET=                 # [DIFERE recomendado]

# --- IA (Claude) -------------------------------------------------------------
ANTHROPIC_API_KEY=                   # [COMPARTILHADO]

# --- Parametros de negocio (hoje por env; futuro: tenant_config) -------------
TETO_DESCONTO_MANUAL_PERCENT=15      # [COMPARTILHADO] (por ora)
# SPREAD_CAMBIO_PERCENTUAL=          # default em src/lib/cambio.ts
# IOF_CAMBIO_PERCENTUAL=
