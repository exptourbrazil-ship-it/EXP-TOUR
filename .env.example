NEXT_PUBLIC_SUPABASE_URL=https://lvchpskxeohfmistppxl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publica do app. Usada no link do portal nos e-mails.
NEXT_PUBLIC_APP_URL=https://exp-tour.vercel.app

# ATENCAO: o token de PRODUCAO do Mercado Pago comeca sempre com "APP_USR-".
# Qualquer outro prefixo (ex.: "sk_live_" e chave de OUTRO servico) e a variavel
# errada e o portal fica "desconectado". Pegue em Credenciais de producao da
# aplicacao dona do pagamento (EXP Tour - Pix).
MERCADOPAGO_ACCESS_TOKEN=
# ATENCAO: precisa ser o segredo gerado pelo webhook da MESMA aplicacao a que
# pertence o MERCADOPAGO_ACCESS_TOKEN. Segredo de outra aplicacao = todas as
# notificacoes rejeitadas com 401 e nenhum pagamento registrado.
MERCADOPAGO_WEBHOOK_SECRET=
# Legado: NAO e mais enviada em cada cobranca (a entrega ficou so no webhook do
# painel; ver docs/estado-do-portal.md, Secao 4.1). Mantida so por compatibilidade
# do helper notificationUrl(); deixe em branco.
MP_NOTIFICATION_URL=

# Autenticacao dos Vercel Cron (inclui a conciliacao de pagamentos).
CRON_SECRET=

# E-mails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Logo dos e-mails. Sobrescreve a URL padrao (${NEXT_PUBLIC_APP_URL}/email/logo-exp-tour.png).
# So e necessaria se o arquivo for para um CDN. Ver public/email/README.md.
EMAIL_LOGO_URL=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
SESSION_SECRET=
# Assinatura dos webhooks do WhatsApp (App Secret do app na Meta). Obrigatoria:
# sem ela o POST /api/whatsapp/webhook recusa tudo.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Webhook do Zoho CRM (/api/integrations/zoho/webhook). Obrigatoria: sem ela a
# rota recusa. Enviar como header x-exp-webhook-token na Workflow Rule.
ZOHO_WEBHOOK_SECRET=

# Modulo Catalogo/Preco/Cotacao (single-tenant hoje).
# Slug do tenant vigente (tabela `tenant`); as rotas resolvem o tenant_id por ele.
# Futuro multi-tenant: o tenant sai do contexto do usuario, nao do ambiente.
CATALOGO_TENANT_SLUG=forio
# Teto (%) de desconto MANUAL para papeis que nao sejam 'gestor'. Acima disso o
# gestor pode aplicar como override (registrado na auditoria).
TETO_DESCONTO_MANUAL_PERCENT=15
