NEXT_PUBLIC_SUPABASE_URL=https://lvchpskxeohfmistppxl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publica do app. Usada para montar a notification_url das cobrancas do
# Mercado Pago e o link do portal nos e-mails.
NEXT_PUBLIC_APP_URL=https://exp-tour.vercel.app

MERCADOPAGO_ACCESS_TOKEN=
# ATENCAO: precisa ser o segredo gerado pelo webhook da MESMA aplicacao a que
# pertence o MERCADOPAGO_ACCESS_TOKEN. Segredo de outra aplicacao = todas as
# notificacoes rejeitadas com 401 e nenhum pagamento registrado.
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: sobrescreve a notification_url enviada em cada cobranca. Por padrao
# usa ${NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago.
MP_NOTIFICATION_URL=

# Autenticacao dos Vercel Cron (inclui a conciliacao de pagamentos).
CRON_SECRET=

# E-mails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Logo dos e-mails. Precisa ser PNG — SVG nao renderiza em Gmail/Outlook/Yahoo.
# Comitar o arquivo em public/email/ e apontar para ca. Sem esta variavel, o
# cabecalho usa um wordmark em texto (ver public/email/README.md).
EMAIL_LOGO_URL=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
SESSION_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
