# =============================================================================
# .env do DEPLOY DA FORIO (multi-tenant — ver docs/deploy-multi-tenant.md)
# =============================================================================
# Os dois deploys (EXP Tour e Forio) rodam o MESMO repositorio sobre o MESMO
# banco Supabase. Portanto a MAIORIA das variaveis e IGUAL a do EXP Tour
# (ver .env.example). Copie de la e altere APENAS o que estiver marcado
# "### FORIO ###" abaixo.
#
# Preencha no projeto Vercel da Forio (Settings -> Environment Variables),
# Production + Preview. Este arquivo e so referencia (sem segredos reais).

# --- IGUAIS ao EXP Tour (mesmo banco / mesmos servicos) -----------------------
NEXT_PUBLIC_SUPABASE_URL=https://lvchpskxeohfmistppxl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mesmo segredo dos Vercel Cron (a autenticacao dos crons e a mesma).
CRON_SECRET=
# Resend: mesma conta/API key. O remetente da Forio e opcional (ver ### FORIO ###).
RESEND_API_KEY=
# Zoho CRM/Sign, WhatsApp, sessoes: mesmos segredos do EXP Tour.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
SESSION_SECRET=
SUPPLIER_SESSION_SECRET=
# Legado do MP (deixe em branco, igual ao EXP Tour).
MP_NOTIFICATION_URL=
# Parametro de catalogo (mesmo default).
TETO_DESCONTO_MANUAL_PERCENT=15

# --- ### FORIO ### — OBRIGATORIO ALTERAR -------------------------------------
# Tenant do deploy: resolve o tenant_id da Forio (tabela `tenant`, slug 'forio').
# CRITICO: se ficar 'exp-tour' ou vazio, este deploy processaria o tenant errado.
CATALOGO_TENANT_SLUG=forio
# URL publica DESTE deploy (Forio). Entra nos links de e-mail e nos PDFs. NAO
# reaproveitar a URL do EXP Tour.
NEXT_PUBLIC_APP_URL=https://forio-education-uk-bra.vercel.app

# --- ### FORIO ### — NAO DEFINIR (deixe ausente) -----------------------------
# Dono dos registros LEGADOS (titulares.tenant_id = NULL) e o tenant legado, que
# e o EXP Tour (default do codigo). Deixe TENANT_LEGADO_SLUG AUSENTE na Forio —
# defini-la como 'forio' faria a Forio "adotar" os dados historicos do EXP Tour.
# TENANT_LEGADO_SLUG=

# --- Mercado Pago: MESMA conta do EXP Tour (mesmo CNPJ) ----------------------
# Decisao (set/2026): EXP Tour e Forio estao sob o MESMO CNPJ e usam a MESMA
# conta Mercado Pago por enquanto. Copie as MESMAS credenciais do EXP Tour
# (token "APP_USR-..." + webhook secret da MESMA aplicacao).
#
# WEBHOOK (importante): mantenha UM unico webhook no painel do MP, apontando para
# o deploy do EXP Tour (/api/webhooks/mercadopago). Como o banco e o ledger
# `events` sao COMPARTILHADOS, esse webhook ja marca como pago tambem as parcelas
# da Forio (o handler resolve o pagamento pela parcela, nao pelo tenant). O cron
# conciliar-pagamentos — escopado por tenant — e a rede de seguranca de cada
# deploy (a Forio pega sozinha um pagamento seu que o webhook tenha perdido).
# NAO cadastre um 2o webhook para a URL da Forio: seria redundante (o ledger
# deduplica pela idempotency_key, entao nao duplicaria efeito, mas nao ha ganho).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- ### FORIO ### — OPCIONAIS (branding da Forio) ---------------------------
# Remetente dos e-mails da Forio. So use quando o dominio da Forio estiver
# VERIFICADO no Resend; ate la, deixe em branco e o envio cai no remetente padrao
# ja verificado (sem risco de bounce). Ver src/lib/email.ts (fromFor).
RESEND_FROM_EMAIL_FORIO=
# Marca padrao dos e-mails quando o titular nao tem tenant. Titulares da Forio ja
# tem tenant_id=forio, entao isto e so um fallback; pode deixar ausente.
# EMAIL_DEFAULT_TENANT_SLUG=forio
# Logo de e-mail: so sobrescreve o do EXP Tour; a Forio usa o PNG do proprio app.
# Deixe ausente.
# EMAIL_LOGO_URL=
# URLs de marketing/afiliado especificas da Forio (aparecem na Area do Cliente).
# Preencha com as da Forio se existirem; senao, deixe ausente.
# NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# NEXT_PUBLIC_POLITICA_PRIVACIDADE_URL=
# NEXT_PUBLIC_AFILIADO_CHIP_URL=
# NEXT_PUBLIC_AFILIADO_MOEDA_URL=
# NEXT_PUBLIC_AFILIADO_PASSAGEM_URL=
# NEXT_PUBLIC_AFILIADO_VISTO_URL=

# ── IA (leitura de material: price list, brochura, promocao, calendario; faturas) ──
# Provedor: GEMINI por padrao quando GEMINI_API_KEY existe (decisao 16/09/2026: custo —
# plano gratuito; atencao: no plano gratuito o Google pode usar os dados enviados para
# treino e ha limites de requisicoes/dia). ANTHROPIC_API_KEY e a alternativa.
# IA_PROVIDER=gemini|anthropic forca um deles. SEM chave o sistema degrada com falha
# fechada: material fica na fila ('sem_ia'), rascunho de price list nasce vazio, a
# conferencia de faturas fica 'indeterminado'. Nunca publica nada sozinho.
GEMINI_API_KEY=
# Modelo Gemini: o codigo consulta ListModels e escolhe o melhor Flash disponivel para
# a chave (a lista varia por conta). GEMINI_MODEL e so PREFERENCIA (usado se existir).
# GEMINI_MODEL=gemini-3.8-flash
# Documentos com dados pessoais (faturas com nome do estudante) NAO vao para o Gemini
# gratuito. GEMINI_TIER=paid libera (billing ativo no projeto Google — sem treino).
# GEMINI_TIER=paid
ANTHROPIC_API_KEY=
# Modelo Anthropic (default no codigo: claude-opus-5).
PRICE_EXTRACT_MODEL=claude-opus-5
# IA_PROVIDER=

# Chave que o Chat da Forio usa nas rotas /api/public/preco/* (Bearer). Sem ela
# as rotas recusam (falha fechada). Gere com: openssl rand -hex 32
CHAT_API_KEY=
