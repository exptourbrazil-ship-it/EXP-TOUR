# =============================================================================
# .env de exemplo — projeto Vercel do TENANT: FORIO
# Copie para o projeto Forio na Vercel (Settings -> Environment Variables).
# Placeholders apenas — nunca comite segredos reais (.gitignore ignora .env).
# Ver docs/deploy-multi-tenant.md.
#
# Legenda:
#   [DIFERE]        muda entre EXP Tour e Forio
#   [COMPARTILHADO] mesmo valor nos dois projetos
#   [DECISAO]       depende de a conta do provedor ser compartilhada ou por tenant
# =============================================================================

# --- Tenant do deploy (a chave de tudo) --------------------------------------
CATALOGO_TENANT_SLUG=forio           # [DIFERE]
EMAIL_DEFAULT_TENANT_SLUG=forio      # [DIFERE] deixe igual ao slug acima

# --- URL publica -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://forio.com.br   # [DIFERE] (forio.vercel.app tambem aponta pra ca)

# --- Banco (Supabase) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://lvchpskxeohfmistppxl.supabase.co  # [COMPARTILHADO]
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # [COMPARTILHADO]
SUPABASE_SERVICE_ROLE_KEY=           # [COMPARTILHADO]

# --- E-mails (Resend) --------------------------------------------------------
RESEND_API_KEY=                                        # [COMPARTILHADO] (ou por tenant)
# ATENCAO: o remetente do Forio vem de RESEND_FROM_EMAIL_FORIO (lido por
# tenant-brand.ts). RESEND_FROM_EMAIL fica so como fallback padrao.
RESEND_FROM_EMAIL_FORIO=Área do Cliente Forio <noreply@forio.com.br>  # [DIFERE] dominio verificado no Resend
RESEND_FROM_EMAIL=                                     # fallback; pode deixar em branco
EMAIL_LOGO_URL=                                        # [DIFERE] opcional (CDN)

# --- Marca / links exibidos --------------------------------------------------
# Site-owned: convencao do dominio forio.com.br (ajuste as rotas reais).
ADMIN_EMAIL=contato@forio.com.br                       # [DIFERE] contato/alertas Forio
NEXT_PUBLIC_POLITICA_PRIVACIDADE_URL=https://forio.com.br/politica-de-privacidade/  # [DIFERE] confira a rota real
# Terceiros/negocio — NAO ha como derivar; use o link especifico da Forio:
NEXT_PUBLIC_GOOGLE_REVIEW_URL=       # [DIFERE] <preencher: link de avaliacao do Google da Forio>
NEXT_PUBLIC_AFILIADO_CHIP_URL=       # [DIFERE] <preencher: link de afiliado (chip) da Forio>
NEXT_PUBLIC_AFILIADO_MOEDA_URL=      # [DIFERE] <preencher: link de afiliado (moeda) da Forio>
NEXT_PUBLIC_AFILIADO_PASSAGEM_URL=   # [DIFERE] <preencher: link de afiliado (passagem) da Forio>
NEXT_PUBLIC_AFILIADO_VISTO_URL=      # [DIFERE] <preencher: link de afiliado (visto) da Forio>

# --- Pagamento (Mercado Pago) ------------------------------------------------
# Se a conta do MP for propria do Forio: token/segredo do Forio e o webhook do MP
# aponta para ${NEXT_PUBLIC_APP_URL}/api/webhooks/mercadopago (URL do Forio).
MERCADOPAGO_ACCESS_TOKEN=            # [DECISAO]
MERCADOPAGO_WEBHOOK_SECRET=          # [DECISAO]
MP_NOTIFICATION_URL=                 # legado: deixe em branco (deriva de APP_URL)

# --- CRM/Sign (Zoho) ---------------------------------------------------------
ZOHO_CLIENT_ID=                      # [DECISAO]
ZOHO_CLIENT_SECRET=                  # [DECISAO]
ZOHO_REFRESH_TOKEN=                  # [DECISAO]
ZOHO_WEBHOOK_SECRET=                 # [DECISAO]

# --- WhatsApp ----------------------------------------------------------------
WHATSAPP_APP_SECRET=                 # [DECISAO]
WHATSAPP_ACCESS_TOKEN=               # [DECISAO]
WHATSAPP_PHONE_NUMBER_ID=            # [DECISAO]
WHATSAPP_VERIFY_TOKEN=               # [DECISAO]

# --- Cron --------------------------------------------------------------------
# ATENCAO (ver runbook, secao Cron): enquanto os crons nao forem todos
# tenant-aware, DESATIVE o Vercel Cron neste projeto (Forio) para nao duplicar os
# jobs globais. Reative quando o follow-up de crons por tenant estiver feito.
CRON_SECRET=                         # recomendado distinto por projeto

# --- Segredos de sessao (recomendado DISTINTOS por projeto) ------------------
SESSION_SECRET=                      # [DIFERE recomendado]
ADMIN_SESSION_SECRET=                # [DIFERE recomendado]
SUPPLIER_SESSION_SECRET=             # [DIFERE recomendado] (fallback: SESSION_SECRET)
ADMIN_CAMBIO_SECRET=                 # [DIFERE recomendado]

# --- IA (Claude) -------------------------------------------------------------
ANTHROPIC_API_KEY=                   # [COMPARTILHADO]

# --- Parametros de negocio (hoje por env; futuro: tenant_config) -------------
TETO_DESCONTO_MANUAL_PERCENT=15      # [COMPARTILHADO] (por ora)
# SPREAD_CAMBIO_PERCENTUAL=          # default em src/lib/cambio.ts
# IOF_CAMBIO_PERCENTUAL=
